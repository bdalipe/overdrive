# Runtime environment: dev | prod
BOT_ENV=dev

# Bot credentials (use one token per process / env file)
DISCORD_BOT_TOKEN=
# Legacy alias supported during migration:
# TOKEN=

# Required for npm run register-commands
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Supabase (Phase 1+ — server-side bot only; use service role, never commit real keys)
# Project URL: Supabase dashboard → Project Settings → API
SUPABASE_URL=
# Secret key bypasses RLS; keep out of client code and version control
SUPABASE_SECRET_KEY=
